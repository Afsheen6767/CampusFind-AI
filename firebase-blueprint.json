{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Lost or found item report on campus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "description": { "type": "string", "maxLength": 1000 },
        "color": { "type": "string" },
        "brand": { "type": "string" },
        "location": { "type": "string", "maxLength": 200 },
        "date": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending_match", "resolved"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "category", "description", "location", "date", "contactName", "contactEmail", "status", "userId"]
    },
    "User": {
      "title": "User",
      "description": "University student or staff member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "department": { "type": "string" },
        "studentId": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Collection of lost and found item reports"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles for students and faculty"
    }
  }
}
